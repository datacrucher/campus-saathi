{
  "name": "campus-saathi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch --disable-warning=ExperimentalWarning --import tsx backend/index.ts",
    "build": "tsc -b && tsc -p backend/tsconfig.json && vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx backend/index.ts",
    "typecheck": "tsc -b && tsc -p backend/tsconfig.json",
    "ml:evaluate": "node --import tsx ml/evaluate-triage.ts",
    "ml:export": "node --disable-warning=ExperimentalWarning --import tsx ml/export-dataset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
